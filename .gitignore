.DS_Store
__pycache__/
*.pyc
.cache/
# device drafts: build.py, device.json and lift.json are versioned; generated decks and renders are not
devices/work/**/*.pptx
devices/work/**/*.png
devices/work/**/render/
devices/work/**/*.manifest.json
*.pdf
# Renders of raw reference slides never enter the skill repo.
**/corpus-renders/
# refs/ (the greeked reference pack: sheets, views, catalog.json) is versioned, so the skill runs with no library.
!refs/
!refs/**
